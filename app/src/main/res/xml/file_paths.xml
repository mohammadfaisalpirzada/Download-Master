<?xml version="1.0" encoding="utf-8"?>
<!-- Only the folders the app really shares from: nothing else can be exposed through the provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 8 / 9 downloads in the public Movies and Music folders -->
    <external-path name="dm_movies" path="Movies/DownloadMaster/" />
    <external-path name="dm_music" path="Music/DownloadMaster/" />
    <!-- Downloaded update APK handed to the package installer -->
    <cache-path name="dm_updates" path="updates/" />
</paths>
